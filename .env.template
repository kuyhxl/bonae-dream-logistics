# 이 파일을 .env로 복사하면 로컬 전체 스택이 그대로 기동됩니다.
#   cp .env.template .env
#
# 여기 있는 값은 전부 로컬 개발 전용입니다. 운영은 배포 환경변수로 별도 주입합니다.
# 실제 토큰/키는 커밋되면 안 되므로 이 파일에는 더미만 둡니다.

# ---------- 데이터베이스 ---------- #
POSTGRES_DB=bonae
POSTGRES_USER=bonae
POSTGRES_PASSWORD=local1234

# ---------- 인증 ---------- #
# 로컬 개발 전용 더미값입니다.
#   openssl rand -base64
JWT_SECRET=bG9jYWwtZGV2LW9ubHktbm90LWZvci1wcm9kdWN0aW9uLWJvbmFlLWRyZWFtLWxvZ2lzdGljcw==

# 마스터 관리자 시드 계정(master01)의 BCrypt 해시. 평문은 Master1234! 입니다.
MASTER_PASSWORD_HASH=$$2a$$10$$axzdGgU52ESAaIn0HLXQROLkPBiatHMY7ra1iSiIjjVUivP0TLySC

# ---------- 슬랙 / AI (message-service) ---------- #
# mock=true면 실제 API 대신 스텁이 등록되어 키 없이도 기동됩니다.
# 실제 연동을 확인하려면 키를 채우고 해당 mock 값을 false로 바꾸세요.

SLACK_TOKEN=dummy
SLACK_MOCK=true

# Gemini API 키
GEMINI_API_KEY=dummy
GEMINI_MOCK=true
GEMINI_MODEL=gemini-flash-latest
